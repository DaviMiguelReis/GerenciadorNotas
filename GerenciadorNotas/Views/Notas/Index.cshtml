@model GerenciadorNotas.ViewModels.NotasIndexViewModel

@{
    ViewData["Title"] = "Notas Acadêmicos";
}

<div class="page-heading">
    <div>
        <h1>Notas Acadêmicos</h1>
        <p>Gerencie as Notas cadastrados.</p>
    </div>
    <a asp-action="Cadastrar" class="button">Nova Nota</a>
</div>

<!-- Barra de pesquisa -->
<form asp-action="Index" method="get" class="toolbar">
    <div class="search-form">
        <input type="text"
               name="pesquisa"
               value="@Model.TextoPesquisa"
               class="input"
               placeholder="Pesquisar por título..." />

        <input type="hidden"
               name="ordenarPor"
               value="@Model.OrdenarPor" />

        <button type="submit" class="button">
            Pesquisar
        </button>

        <a asp-action="Index" class="button secondary">
            Limpar
        </a>
    </div>
</form>

<!-- Contador -->
<div class="list-meta">
    @if (string.IsNullOrWhiteSpace(Model.TextoPesquisa))
    {
        <p class="counter">
            @Model.QuantidadeTotal projeto(s) cadastrado(s)
        </p>
    }
    else
    {
        <p class="counter">
            @Model.QuantidadeTotal resultado(s) para
            "<strong>@Model.TextoPesquisa</strong>"
        </p>
    }
</div>

<!-- Ordenação -->
<p class="sort-links">
    Ordenar por:

    <a asp-action="Index"
       asp-route-pesquisa="@Model.TextoPesquisa"
       asp-route-ordenarPor="titulo"
       class="@(Model.OrdenarPor == "titulo" ? "active" : null)">
        Título
    </a>

    <a asp-action="Index"
       asp-route-pesquisa="@Model.TextoPesquisa"
       asp-route-ordenarPor="cargaHoraria"
       class="@(Model.OrdenarPor == "dataCriacao" ? "active" : null)">
        Data Criação
    </a>
</p>

@if (TempData["Mensagem"] is not null)
{
    <div class="alert success">
        @TempData["Mensagem"]
    </div>
}

@if (Model.Notas.Count == 0)
{
    <div class="empty">Nenhum Nota cadastrada.</div>
}
else
{
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Título</th>
                    <th>Data Criação</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var projeto in Model.Notas)
                {
                    <tr>
                        <td>@projeto.Titulo</td>
                        <td>@projeto.DataCriacao?.ToString("dd/MM/yyyy") </td>
                        <td class="actions">
                            <a asp-action="Detalhes" asp-route-id="@projeto.Id">Detalhes</a>
                            <a asp-action="Editar" asp-route-id="@projeto.Id">Editar</a>
                            <a class="danger-link" asp-action="Excluir" asp-route-id="@projeto.Id">Excluir</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
