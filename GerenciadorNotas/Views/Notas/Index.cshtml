@model List<GerenciadorNotas.Models.Nota>

@{
    ViewData["Title"] = "Notas Acadêmicos";
}

<div class="page-heading">
    <div>
        <h1>Notas Acadêmicos</h1>
        <p>Gerencie as Notas cadastrados.</p>
    </div>
    <a asp-action="Cadastrar" class="button">Nova Nota</a>
</div>

@if (TempData["Mensagem"] is not null)
{
    <div class="alert success">
        @TempData["Mensagem"]
    </div>
}

@if (Model.Count == 0)
{
    <div class="empty">Nenhum Nota cadastrada.</div>
}
else
{
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Título</th>
                    <th>Data Criação</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var projeto in Model)
                {
                    <tr>
                        <td>@projeto.Titulo</td>
                        <td>@projeto.DataCriacao horas</td>
                        <td class="actions">
                            <a asp-action="Detalhes" asp-route-id="@projeto.Id">Detalhes</a>
                            <a asp-action="Editar" asp-route-id="@projeto.Id">Editar</a>
                            <a class="danger-link" asp-action="Excluir" asp-route-id="@projeto.Id">Excluir</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
