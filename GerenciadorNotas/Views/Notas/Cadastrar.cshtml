@model GerenciadorNotas.ViewModels.NovaNotaViewModel

@{
    ViewData["Title"] = "Cadastrar Notas";
}

<h1>Cadastrar Notas</h1>

<form asp-action="Cadastrar" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Titulo" class="form-label">Título</label>
        <input asp-for="Titulo" class="form-control" />
        <span asp-validation-for="Titulo" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Conteudo" class="form-label">Contéudo</label>
        <textarea asp-for="Conteudo" class="form-control"></textarea>
        <span asp-validation-for="Conteudo" class="text-danger"></span>
    </div>

    @*<div class="mb-3">
        <label asp-for="DataCriacao" class="form-label">Data Criação</label>
        <input asp-for="DataCriacao" type ="date"class="form-control" />
        <span asp-validation-for="DataCriacao" class="text-danger"></span>
    </div> *@

    <button type="submit" class="btn btn-success">Salvar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}