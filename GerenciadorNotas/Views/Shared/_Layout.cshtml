<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Gerenciador Notas</title>

    <!-- Bootstrap -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <!-- CSS do projeto -->
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
</head>

<body>
    <header>
        <nav class="nav">
            <a class="brand"
               asp-controller="Projetos"
               asp-action="Index">
                Gerenciador Acadêmico
            </a>

            <a asp-controller="Projetos"
               asp-action="Index">
                Projetos
            </a>

            <a asp-controller="Projetos"
               asp-action="Cadastrar">
                Novo Projeto
            </a>
        </nav>
    </header>

    <main class="container py-4">
        @RenderBody()
    </main>

    <!-- Scripts de validação das Views -->
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>